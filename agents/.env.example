# Copy to agents/.env for local runs. For GitHub Actions these are repository secrets.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co     # base URL, nothing after .supabase.co
SUPABASE_SERVICE_ROLE_KEY=                         # secret key, keep it out of the app

# My keys. Other users add their own in the app and only get these if use_shared_keys is on for them.
# Comma-separated lists are tried in order.
GEMINI_API_KEYS=                                   # aistudio.google.com/apikey (different projects = separate quotas)
ADZUNA_KEYS=                                       # appid:appkey,appid:appkey  (developer.adzuna.com)
RAPIDAPI_KEYS=                                     # JSearch on RapidAPI, optional
GROQ_API_KEY=                                      # console.groq.com, optional
# Single-key names work too: GEMINI_API_KEY, ADZUNA_APP_ID + ADZUNA_APP_KEY, RAPIDAPI_KEY

GEMINI_MODEL=auto
GEMINI_FAST_MODEL=auto
GEMINI_USE_ALL_MODELS=true
# GEMINI_MIN_INTERVAL_SEC=                         # defaults: 12.5s flash, 4.5s flash-lite
# JOB_RETENTION_DAYS=30
