# Copy to agents/.env for local runs. In GitHub Actions, add these as repository secrets.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co     # base URL only – nothing after .supabase.co
SUPABASE_SERVICE_ROLE_KEY=                         # Supabase > Project Settings > API Keys > secret key (keep private!)

# Shared keys = the owner's keys. Other users add their own keys in the app (Settings → API keys)
# and only use these if you set accounts.use_shared_keys = true for them.
# Several keys, comma separated = fallback order: when one hits its limit the next one is used.
GEMINI_API_KEYS=                                   # key1,key2   https://aistudio.google.com/apikey (each from a different Google Cloud project!)
ADZUNA_KEYS=                                       # appid1:appkey1,appid2:appkey2   https://developer.adzuna.com
RAPIDAPI_KEYS=                                     # optional, JSearch free tier https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# The single-key names still work too: GEMINI_API_KEY, ADZUNA_APP_ID + ADZUNA_APP_KEY, RAPIDAPI_KEY

GEMINI_MODEL=gemini-3.5-flash                      # scoring, tailoring, interview prep, cover letters
GEMINI_FAST_MODEL=gemini-3.5-flash-lite            # bulk relevance filtering (retired models are replaced automatically)
GEMINI_MIN_INTERVAL_SEC=6                          # starting gap between calls per key+model; widens automatically on 429s
