# Copy to agents/.env for local runs. In GitHub Actions, add these as repository secrets.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                # Supabase > Project Settings > API > service_role (keep secret!)

GEMINI_API_KEY=                           # https://aistudio.google.com/apikey (free)
GEMINI_MODEL=gemini-2.5-flash             # used for scoring, tailoring, interview prep, cover letters
GEMINI_FAST_MODEL=gemini-2.5-flash-lite   # used for bulk relevance filtering
GEMINI_MIN_INTERVAL_SEC=6                 # spacing between calls (free tier ~10 requests/min)
LLM_MAX_CALLS_PER_RUN=60                  # hard cap per hourly run; leftover jobs wait for the next run

ADZUNA_APP_ID=                            # https://developer.adzuna.com (free)
ADZUNA_APP_KEY=
RAPIDAPI_KEY=                             # optional, JSearch free tier (200 req/month) https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
